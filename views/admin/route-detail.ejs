<a class="back-link" href="/admin/routes"><%- include('../partials/icon', { name: 'back' }) %> เส้นทาง</a>

<div class="page-bar">
  <div>
    <h1><%= route.route_name %></h1>
    <div class="muted"><span class="mono"><%= route.route_id %></span> · <%= route.stop_count %> จุดจอด · เวลารวม <b><%= route.total_minutes %> นาที</b> · ใช้ใน <%= trips.total %> รอบ (เปิดอยู่ <%= trips.open || 0 %>)</div>
  </div>
  <% if (can(SCREEN.ROUTES, 'edit')) { %><a class="btn btn-primary" href="/admin/routes/<%= route.route_id %>/edit">แก้ไขเส้นทาง</a><% } %>
</div>

<div class="grid-2" style="align-items:start">
  <div class="card">
    <h2 class="card-title">Route diagram</h2>
    <ol class="route">
      <% stops.forEach((s) => { %>
        <li class="in-seg">
          <span class="t">+<%= s.cum_minutes %></span>
          <span class="dot" aria-hidden="true"></span>
          <span>
            <span class="name"><%= s.stop_name %></span>
            <div class="sub">ลำดับ <%= s.stop_order %> · <%= s.stop_order === 1 ? 'ต้นทาง' : `จากจุดก่อนหน้า ${s.travel_minutes} นาที` %></div>
          </span>
        </li>
      <% }) %>
    </ol>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th class="right">ลำดับ</th><th>จุดจอด</th><th class="right">เวลาจากจุดก่อนหน้า</th><th class="right">สะสม</th></tr></thead>
      <tbody>
        <% stops.forEach((s) => { %>
          <tr><td class="right"><%= s.stop_order %></td><td><span class="mono muted"><%= s.stop_id %></span> <%= s.stop_name %></td><td class="right"><%= s.travel_minutes %> นาที</td><td class="right"><%= s.cum_minutes %> นาที</td></tr>
        <% }) %>
      </tbody>
      <tfoot><tr><td></td><td>เวลารวม</td><td class="right"><%= route.total_minutes %> นาที</td><td></td></tr></tfoot>
    </table>
  </div>
</div>
