<div class="page-bar">
  <div>
    <h1>การจอง</h1>
    <% if (f.trip) { %><div class="muted small">เฉพาะรอบ <span class="mono"><%= f.trip %></span> · <a href="/admin/bookings">ดูทั้งหมด</a></div><% } %>
  </div>
</div>

<form class="filters" method="get" action="/admin/bookings" role="search">
  <% if (f.trip) { %><input type="hidden" name="trip" value="<%= f.trip %>"><% } %>
  <div class="field wide">
    <label for="q">ค้นหา</label>
    <input class="input" id="q" name="q" value="<%= f.q %>" placeholder="รหัสการจอง, รายการจอง, ชื่อผู้จอง, QR">
  </div>
  <div class="field">
    <label for="from">วันที่เดินรถ ตั้งแต่</label>
    <input class="input" type="date" id="from" name="from" value="<%= f.from %>">
  </div>
  <div class="field">
    <label for="to">ถึง</label>
    <input class="input" type="date" id="to" name="to" value="<%= f.to %>">
  </div>
  <div class="field">
    <label for="status">สถานะการจอง</label>
    <select class="input" id="status" name="status">
      <option value="">ทั้งหมด</option>
      <% statuses.forEach((s) => { %><option <%= s === f.status ? 'selected' : '' %>><%= s %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="route">เส้นทาง</label>
    <select class="input" id="route" name="route">
      <option value="">ทั้งหมด</option>
      <% routes.forEach((r) => { %><option value="<%= r.route_id %>" <%= r.route_id === f.route ? 'selected' : '' %>><%= r.route_name %></option><% }) %>
    </select>
  </div>
  <div class="btn-row"><button class="btn" type="submit">ค้นหา</button><a class="btn btn-ghost" href="/admin/bookings">ล้าง</a></div>
</form>

<% if (!rows.length) { %>
  <div class="card empty"><strong>ไม่พบรายการจอง</strong></div>
<% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>การจอง</th><th>รายการจอง</th><th>ผู้จอง</th><th>วันที่และเวลาจอง</th><th>รอบ</th><th>จุดขึ้น → จุดลง</th><th class="right">ที่นั่ง</th><th>สถานะ</th><th>Check-in</th><th class="right">จัดการ</th></tr>
      </thead>
      <tbody>
        <% rows.forEach((i) => { %>
          <tr>
            <td class="mono"><a href="/admin/bookings/<%= i.booking_id %>"><%= i.booking_id %></a></td>
            <td class="mono"><%= i.booking_item_id %></td>
            <td class="nowrap"><%= i.passenger_name %></td>
            <td class="nowrap"><%= fmtDateTime(i.booked_at) %></td>
            <td class="nowrap"><%= fmtDate(i.trip_date) %> <%= fmtTime(i.depart_time) %><br><span class="small muted"><%= i.route_name %> · <%= i.trip_id %></span></td>
            <td><%= i.board_stop %> → <%= i.alight_stop %></td>
            <td class="right"><%= i.seats %></td>
            <td><%- badge(itemStatus(i)) %></td>
            <td class="nowrap"><%= i.checkin_at ? fmtTime(i.checkin_at) : '—' %></td>
            <td class="actions"><a class="btn btn-sm" href="/admin/bookings/<%= i.booking_id %>">รายละเอียด</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="small muted mt-2">ทั้งหมด <%= rows.length %> รายการ</p>
<% } %>
